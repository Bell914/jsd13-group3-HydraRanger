# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
SEED_ADMIN_PASSWORD=replace_with_a_development_admin_password
SEED_USER_PASSWORD=replace_with_a_development_user_password

# Development-only bootstrap admin credentials
# Production must use an admin account stored in MongoDB.
ADMIN_EMAIL=admin@occasion.dev
ADMIN_PASSWORD=replace_with_a_development_admin_password

# Exact websites allowed to call this API
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
# Number of trusted reverse proxies in front of Express (Render normally uses 1)
TRUST_PROXY=1

# SMTP is required to deliver password reset links outside development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Google AI (Gemini) for Mix & Match image analysis
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Stripe payments (keep real keys in server/.env, never commit them)
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
