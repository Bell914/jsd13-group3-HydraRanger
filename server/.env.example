# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/hydraranger_db
# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
SEED_ADMIN_PASSWORD=replace_with_a_development_admin_password
SEED_USER_PASSWORD=replace_with_a_development_user_password

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173
