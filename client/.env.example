# Local development defaults (auto-loaded by Vite):
#   .env.development            -> VITE_API_BASE_URL=http://localhost:5002/api
#   .env.production (build)     -> VITE_API_BASE_URL=https://jsd13-group3-hydraranger.onrender.com/api
#
# Override per command (no file edit needed):
#   VITE_API_BASE_URL=http://localhost:5002/api npm run dev
#   VITE_API_BASE_URL=https://jsd13-group3-hydraranger.onrender.com/api npm run dev
#
# Runtime override (no rebuild): set localStorage in the browser console, then refresh
#   localStorage.setItem("occasion_api_url", "http://localhost:5002/api")
#   localStorage.removeItem("occasion_api_url")   # back to automatic/environment value
#
# Your private overrides go in .env.local / .env.development.local (gitignored).
VITE_API_BASE_URL=http://localhost:5002/api

# PromptPay ID the checkout QR pays to (phone number or tax id registered with your bank).
# Without it the QR falls back to the placeholder id, which real banking apps reject.
VITE_PROMPTPAY_ID=

# Payments run in demo mode (PromptPay QR + demo card form) and need no keys.
